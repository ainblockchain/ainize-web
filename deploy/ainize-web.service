[Unit]
# ainize.ai — the Next.js app: the site and its backend in one process.
#
# It is not a static directory any more. The pages are half of it; `/api/*` and `/agents/*` are route handlers,
# and they are what keeps the node's address on the server. nginx proxies the domain here.
#
# Install (as the user that owns the releases):
#   mkdir -p ~/.config/systemd/user && cp deploy/ainize-web.service ~/.config/systemd/user/
#   sudo loginctl enable-linger $USER          # or it stops when your last session ends
#   systemctl --user daemon-reload && systemctl --user enable --now ainize-web
Description=ainize.ai (Next.js: site + backend)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ainize-web-releases/current
# The main node. Loopback on this machine, and never named to a browser — that is the point of the backend.
Environment=AINIZE_NODE_URL=http://127.0.0.1:3400
Environment=NODE_ENV=production
Environment=PORT=3900
ExecStart=%h/.local/node/bin/npx next start -p 3900
Restart=always
RestartSec=3

[Install]
WantedBy=default.target

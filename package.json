    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router": "^7.13.0",
    "recharts": "^3.10.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@ainize/core": "^0.3.1",
    "@ainize/node": "^0.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
